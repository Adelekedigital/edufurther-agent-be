# --- Application ---
ENVIRONMENT=development
APP_NAME=edufurther-agent
APP_VERSION=0.1.0
# Stamped on every job, output and evidence record. Bump to deliberately
# reprocess already-processed discoveries without creating duplicates.
WORKFLOW_VERSION=scholarship-verification-v1

# --- Database ---
# Agent-owned. Never a Scholarship Finder connection string: this service
# integrates with the product over HTTP and must not be able to read or
# write its tables.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55434/edufurther_agent
# Bounds the /ready probe only, so an unreachable database fails it
# promptly. The pool's own connect timeout is separate and more generous:
# opening several connections at once under load is normal, and one value
# for both makes a burst of concurrent workflows look like an outage.
DB_CONNECT_TIMEOUT_SECONDS=3.0
DB_POOL_CONNECT_TIMEOUT_SECONDS=15.0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Inbound authentication ---
# What this service accepts on its own internal surface - the same name,
# and the same meaning, as Scholarship Finder's. Deliberately NOT
# AGENT_SERVICE_TOKEN: on Finder that name means what Finder accepts *from*
# this service, so reusing it here would give one name two roles. The
# outbound half is SCHOLARSHIP_FINDER_AGENT_TOKEN below, and the two are
# different secrets.
# Required in staging and production; the service refuses to boot without it.
INTERNAL_SERVICE_TOKEN=

# --- AI Router (outbound) ---
# This service holds the private key; the router holds only the public half,
# registered under AI_ROUTER_PRODUCT_ID in its SERVICE_CALLERS.
AI_ROUTER_BASE_URL=
AI_ROUTER_PRIVATE_KEY_PEM=
# The registered `kid`. Bump on every key rotation.
AI_ROUTER_KEY_ID=
AI_ROUTER_PRODUCT_ID=edufurther_agent
AI_ROUTER_TIMEOUT_SECONDS=45

# --- Scholarship Finder (outbound) ---
# Scoped to /internal/agent/* - deliberately not the admin service token.
SCHOLARSHIP_FINDER_BASE_URL=
SCHOLARSHIP_FINDER_AGENT_TOKEN=
SCHOLARSHIP_FINDER_TIMEOUT_SECONDS=30

# Shadow mode writes evidence and run records but never creates or updates a
# review task. Default true: an unconfigured environment cannot affect the
# product's review queue.
SHADOW_MODE=true

# --- Jobs ---
JOB_LEASE_SECONDS=900
JOB_MAX_ATTEMPTS=5
JOB_SWEEP_INTERVAL_SECONDS=60
JOB_SWEEP_BATCH_LIMIT=20
MAX_WORKFLOW_DURATION_SECONDS=1800

# --- Tools ---
# Unset keeps a provider off entirely, the same pattern both sibling
# services use. Scholarship Finder's JINA_API_KEY is unset at cutover so
# this service owns the whole monthly allowance.
# Per-tool kill switches, as a JSON array. Takes effect on the next call,
# no deploy needed. Known tools: direct_fetch, jina, tavily, parsebot.
DISABLED_TOOLS=[]
JINA_API_KEY=
JINA_MONTHLY_CALL_LIMIT=500
JINA_TIMEOUT_SECONDS=30
FETCH_TIMEOUT_SECONDS=15
FETCH_CONNECT_TIMEOUT_SECONDS=5
FETCH_MAX_BYTES=2000000
# Minimum gap between two direct fetches of the same host. Discoveries
# arrive grouped by source, so a batch is many requests to one origin in
# quick succession - which a real run turned into a 35% connect-failure
# rate and a retry for every third page. Set to 0 to disable.
FETCH_MIN_HOST_INTERVAL_SECONDS=1.5
# Registered but unimplemented until harvesting moves off Scholarship
# Finder. Present so the kill switch and timeout policy already exist when
# they arrive, rather than being retrofitted.
TAVILY_TIMEOUT_SECONDS=30
PARSEBOT_TIMEOUT_SECONDS=60

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENABLED=
